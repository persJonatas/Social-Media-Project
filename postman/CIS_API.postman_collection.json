{
  "info": {
    "_postman_id": "c15a0001-c15a-4000-8000-000000000001",
    "name": "CIS API - Collaborative Ideation Solution",
    "description": "Coleção de requisições para a CIS API (Tópicos, Ideias e Votos), incluindo autenticação via JWT Bearer Token e validações automáticas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Autenticação (Users API)",
      "item": [
        {
          "name": "Obter Token JWT (Login)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"maria.s\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{usersApiUrl}}/auth/login",
              "host": ["{{usersApiUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Autentica na Users API para obter um token JWT válido e armazenar automaticamente na variável de ambiente {{authToken}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code é 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"authToken\", jsonData.token);",
                  "    console.log(\"Token JWT salvo com sucesso na variável authToken!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
