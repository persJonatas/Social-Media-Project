        {
          "name": "3.2 Tentar Voto Duplicado (Esperado 409 Conflict)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ideas/{{ideaId}}/votes",
              "host": ["{{baseUrl}}"],
